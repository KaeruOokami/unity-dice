// Dice game Quantum DSL: input, board, dice ledger, spawn, versus.
input
{
    button MoveN;
    button MoveE;
    button MoveS;
    button MoveW;
    button Lift;
    button Jump;
}

enum DiceKind
{
    Normal,
    Wood,
    Iron,
    Magnet,
    Ice,
    Stone,
    Ghost,
    Jumbo
}

enum DiceStackTier
{
    Bottom,
    Top
}

singleton component Board
{
    Int32 Width;
    Int32 Height;
    Boolean Initialized;
    // Versus partition column (0 = disabled). Production VersusArenaLayout.PartitionX.
    Int32 PartitionX;
}

component GridPose
{
    Int32 X;
    Int32 Y;
}

component PlayerPawn
{
    PlayerRef Player;
    EntityRef CarriedDice;
    Boolean HasCarriedDice;
    Boolean IsOnFloor;
    DiceStackTier StandingTier;
    Int32 FacingX;
    Int32 FacingY;
    // Continuous surface pose (Phase 1). GridPose remains the logical standing cell.
    Boolean HasWorldPose;
    FP WorldX;
    FP WorldZ;
    FP MoveSpeed;
    // Phase 2 push-follow (tracks pushed dice — contact, not ride).
    Boolean HasPushFollow;
    EntityRef PushFollowDice;
    Int32 PushFollowDirX;
    Int32 PushFollowDirY;
    Int32 PushFollowFromX;
    Int32 PushFollowFromY;
    Int32 PushFollowTicksRemaining;
    Int32 PushFollowTicksTotal;
    // Domain CoupledWalkRoll session (roll + ride lock as one unit).
    Boolean HasCoupledWalkRoll;
    EntityRef CoupledWalkRollDice;
    Int32 CoupledWalkRollDirX;
    Int32 CoupledWalkRollDirY;
    Int32 CoupledWalkRollFromX;
    Int32 CoupledWalkRollFromY;
    Int32 CoupledWalkRollDestX;
    Int32 CoupledWalkRollDestY;
    Int32 CoupledWalkRollTicksRemaining;
    Int32 CoupledWalkRollTicksTotal;
    Int32 CoupledWalkRollStandingTier;
    FP CoupledWalkRollCellSize;
    // Production JumpPhase.Airborne (GravityMotion + JumpInputPolicy).
    Boolean IsJumping;
    Boolean JumpDiceGridMoved;
    Boolean IsJumpArc;
    FP JumpOffsetY;
    FP JumpVelocityY;
    FP JumpHeight;
    FP JumpLaunchVy;
    // Production LiftPhase (Domain LiftMotionTiming).
    Int32 LiftPhase;
    Int32 LiftBusyTicksRemaining;
}

component Dice
{
    DiceKind Kind;
    DiceStackTier Tier;
    Int32 TopFace;
    Int32 NorthFace;
    Int32 EastFace;
    Boolean IsCarried;
    Boolean IsErasing;
    Boolean IsSpawning;
    Int32 EraseTicksRemaining;
    Int32 EraseTicksTotal;
    PlayerRef Owner;
    // Phase 2: gates re-push / lift while View roll/slide plays.
    Boolean IsMotionBusy;
    Int32 MotionTicksRemaining;
    // Match after settle (production ActionCompleted): evaluate when !IsMotionBusy.
    Boolean HasPendingMatch;
    PlayerRef PendingMatchPlayer;
}

singleton component MatchPending
{
    Boolean HasPending;
    EntityRef ActionDice;
    PlayerRef ActingPlayer;
}

singleton component SpawnState
{
    Boolean Enabled;
    Int32 CooldownTicksP1;
    Int32 CooldownTicksP2;
}

singleton component VersusAttackState
{
    Int32 DelayTicksP1;
    Int32 RemainingDiceP1;
    Int32 AttackFaceP1;
    Int32 DelayTicksP2;
    Int32 RemainingDiceP2;
    Int32 AttackFaceP2;
}
